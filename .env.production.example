# Copy to a host-only file and replace every CHANGE_ME value.
OPS_AGENT_IMAGE_TAG=latest
# During image rollback, keep this at the newer schema-compatible release.
# Normally it is identical to OPS_AGENT_IMAGE_TAG.
OPS_AGENT_MIGRATION_IMAGE_TAG=latest
OPS_AGENT_HTTPS_PORT=443
# The proxy runs as UID/GID 101. Make the certificate readable and the key
# owned by 101:101 with mode 0400 before deployment.
OPS_AGENT_TLS_CERT_FILE=/etc/xiaoxiagent/tls/fullchain.pem
OPS_AGENT_TLS_KEY_FILE=/etc/xiaoxiagent/tls/privkey.pem

OPS_AGENT_POSTGRES_DB=ops_agent
OPS_AGENT_POSTGRES_USER=ops_agent
OPS_AGENT_POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
OPS_AGENT_DATABASE_URL=postgresql+asyncpg://ops_agent:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/ops_agent
OPS_AGENT_CHECKPOINT_DATABASE_URL=postgresql://ops_agent:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/ops_agent

# Minimum 32 characters. Generate independently from the database password.
OPS_AGENT_SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS

OPS_AGENT_MODEL_PROVIDER=openai-compatible
OPS_AGENT_MODEL_NAME=gpt-4.1-mini
OPS_AGENT_MODEL_BASE_URL=https://api.openai.com/v1
OPS_AGENT_MODEL_STRUCTURED_OUTPUT_MODE=json_schema
OPS_AGENT_MODEL_THINKING_MODE=provider_default
# Use a provider endpoint that returns 2xx/3xx with the configured Bearer key.
OPS_AGENT_MODEL_HEALTH_URL=https://api.openai.com/v1/models
OPS_AGENT_MODEL_API_KEY=CHANGE_ME_MODEL_KEY
# Set current provider rates explicitly; 0 means cost is not estimated.
OPS_AGENT_MODEL_INPUT_COST_PER_MILLION_TOKENS=0
OPS_AGENT_MODEL_OUTPUT_COST_PER_MILLION_TOKENS=0

# Alert transitions are written as JSON to monitor container logs.
OPS_AGENT_MONITOR_INTERVAL_SECONDS=15
OPS_AGENT_MONITOR_FAILURE_THRESHOLD=2
OPS_AGENT_MONITOR_QUEUE_BACKLOG_THRESHOLD=20

OPS_AGENT_SEARCH_PROVIDER=tavily
OPS_AGENT_SEARCH_BASE_URL=https://api.tavily.com
OPS_AGENT_SEARCH_API_KEY=CHANGE_ME_SEARCH_KEY

# Cleanup retention windows. Backups follow a separate company policy.
OPS_AGENT_REPORT_RETENTION_DAYS=180
OPS_AGENT_SOURCE_SNAPSHOT_RETENTION_DAYS=30
OPS_AGENT_JOB_EVENT_RETENTION_DAYS=90
OPS_AGENT_TEMPORARY_ARTIFACT_RETENTION_DAYS=7

# Optional report branding.
OPS_AGENT_REPORT_BRAND_TITLE=
OPS_AGENT_REPORT_BRAND_HEADER=
OPS_AGENT_REPORT_BRAND_LOGO_PATH=
