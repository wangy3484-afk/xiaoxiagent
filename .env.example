# Runtime
OPS_AGENT_ENVIRONMENT=development
OPS_AGENT_LOG_LEVEL=INFO
OPS_AGENT_WEB_PORT=4200

# PostgreSQL and Redis (replace passwords outside local development)
OPS_AGENT_DATABASE_URL=postgresql+asyncpg://ops_agent:ops_agent@postgres:5432/ops_agent
OPS_AGENT_CHECKPOINT_DATABASE_URL=postgresql://ops_agent:ops_agent@postgres:5432/ops_agent
OPS_AGENT_CHECKPOINT_SCHEMA=langgraph_checkpoint
OPS_AGENT_REDIS_URL=redis://redis:6379/0

# Restrict LangGraph checkpoint deserialization to safe MessagePack types.
LANGGRAPH_STRICT_MSGPACK=true

# Session: generate a strong random value; never commit the real value
OPS_AGENT_SESSION_SECRET=
OPS_AGENT_SESSION_COOKIE_NAME=ops_agent_session
OPS_AGENT_SESSION_TTL_MINUTES=480
OPS_AGENT_SESSION_COOKIE_SECURE=false
OPS_AGENT_SESSION_COOKIE_SAME_SITE=lax

# LLM provider
OPS_AGENT_MODEL_PROVIDER=openai-compatible
OPS_AGENT_MODEL_NAME=gpt-4.1-mini
OPS_AGENT_MODEL_BASE_URL=https://api.openai.com/v1
OPS_AGENT_MODEL_API_KEY=
OPS_AGENT_MODEL_TIMEOUT_SECONDS=90
OPS_AGENT_MODEL_MAX_RETRIES=2
OPS_AGENT_MODEL_STRUCTURED_OUTPUT_MODE=json_schema
OPS_AGENT_MODEL_THINKING_MODE=provider_default
# Optional accounting rates; leave at 0 when no internal price is configured.
OPS_AGENT_MODEL_INPUT_COST_PER_MILLION_TOKENS=0
OPS_AGENT_MODEL_OUTPUT_COST_PER_MILLION_TOKENS=0

# Public web search
OPS_AGENT_SEARCH_PROVIDER=tavily
OPS_AGENT_SEARCH_BASE_URL=https://api.tavily.com
OPS_AGENT_SEARCH_API_KEY=
OPS_AGENT_SEARCH_TIMEOUT_SECONDS=20

# Web fetch safety limits
OPS_AGENT_FETCH_TIMEOUT_SECONDS=15
OPS_AGENT_FETCH_MAX_BYTES=2000000
OPS_AGENT_FETCH_MAX_REDIRECTS=5
OPS_AGENT_FETCH_CONCURRENCY=8

# Per-report research and generation budgets
OPS_AGENT_REPORT_MAX_SEARCH_QUERIES=16
OPS_AGENT_REPORT_MAX_SOURCES_PER_QUERY=8
OPS_AGENT_REPORT_MAX_EVIDENCE_ITEMS=80
OPS_AGENT_REPORT_TOKEN_BUDGET=32000
OPS_AGENT_REPORT_TIMEOUT_SECONDS=900

# Artifact storage and data retention
OPS_AGENT_ARTIFACT_STORAGE_PATH=artifacts
OPS_AGENT_REPORT_BRAND_TITLE=
OPS_AGENT_REPORT_BRAND_HEADER=
OPS_AGENT_REPORT_BRAND_LOGO_PATH=
OPS_AGENT_REPORT_RETENTION_DAYS=180
OPS_AGENT_SOURCE_SNAPSHOT_RETENTION_DAYS=30
OPS_AGENT_JOB_EVENT_RETENTION_DAYS=90
OPS_AGENT_TEMPORARY_ARTIFACT_RETENTION_DAYS=7
